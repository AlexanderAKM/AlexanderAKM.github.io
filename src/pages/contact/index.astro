---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Alexander Müller"
  description="Get in touch with me for AI alignment research, collaboration, or just to say hello."
>
  <section class="py-8">
    <h1 class="text-4xl font-bold mb-8">Contact Me</h1>
    
    <div class="max-w-3xl">
      <p class="mb-8 text-lg">
        Have a question about AI safety, want to collaborate, or just want to chat? Fill out the form below or reach out directly.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <div>
          <h2 class="text-2xl font-bold mb-6">Send me a message</h2>
          <form 
            action="https://formspree.io/f/xovdvjgz" 
            method="POST" 
            class="space-y-6"
          >
            <div>
              <label for="name" class="block text-sm font-medium mb-1">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                class="w-full px-4 py-2 border dark:border-slate-700 rounded-md bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium mb-1">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-2 border dark:border-slate-700 rounded-md bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium mb-1">Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                class="w-full px-4 py-2 border dark:border-slate-700 rounded-md bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
              ></textarea>
            </div>
            
            <input type="hidden" name="_subject" value="New message from your website" />
            
            <button 
              type="submit"
              class="px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition-colors"
            >
              Send Message
            </button>
          </form>
        </div>
        
        <div>
          <h2 class="text-2xl font-bold mb-6">Direct Contact</h2>
          <div class="space-y-4 mb-8">
            <p>
              <strong>Personal Email:</strong><br />
              <a href="mailto:alexanderklavermuller@gmail.com" class="text-blue-600 hover:underline">alexanderklavermuller at gmail dot com</a>
            </p>
            <p>
              <strong>Research/Business Email:</strong><br />
              <a href="mailto:a.k.muller.2@student.rug.nl" class="text-blue-600 hover:underline">a dot k dot muller dot 2 at student dot rug dot nl</a><br />
              <a href="mailto:alexander@aisig.org" class="text-blue-600 hover:underline">alexander at aisig dot org</a>
            </p>
            <p>
              <strong>LinkedIn:</strong><br />
              <a href="https://www.linkedin.com/in/alexanderkmüller" target="_blank" class="text-blue-600 hover:underline">www.linkedin.com/in/alexanderkmüller</a>
            </p>
            <p>
              <strong>GitHub:</strong><br />
              <a href="https://github.com/AlexanderAKM" target="_blank" class="text-blue-600 hover:underline">AlexanderAKM</a>
            </p>
          </div>
          
        </div>
      </div>
    </div>
  </section>
</BaseLayout> 