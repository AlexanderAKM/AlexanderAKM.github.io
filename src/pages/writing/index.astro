---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all published writing posts
const allPosts = await getCollection('writing', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort posts by date, newest first
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Extract all tags from posts
const allTags = [...new Set(posts.flatMap(post => post.data.tags || []))].sort();

// Helper to calculate reading time
function getReadingTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 230));
}
---

<BaseLayout
  title="Writing | Alexander Müller"
  description="Thoughts and research on AI alignment, interpretability, game theory, philosophy, and more."
>
  <div class="py-8">
    <h1 class="text-4xl font-bold mb-4">Writing</h1>
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Thoughts and research on AI alignment, interpretability, computational neuroscience, and other topics. These posts vary in quality, content, depth, and style. They reflect my thinking at the time of writing and do not always reflect my current views. 
      Subscribe to my <a href="https://alexandermullerakm.substack.com/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">personal Substack</a> and <a href="https://safeainetherlands.substack.com/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">SAIN's Substack</a> for more regular writing. 
      Although I direct <a href="https://safeainetherlands.org/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline"><strong>Safe AI Netherlands (SAIN)</strong></a> and its Groningen chapter <a href="https://safeainetherlands.org/chapters/groningen" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">SAIN Groningen</a>, this blog is not affiliated with either and my opinions do not necessarily represent the organization.
    </p>
    
    <div id="filter-notice" class="mb-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg hidden">
      <p class="text-sm text-blue-800 dark:text-blue-200">
        Showing posts tagged with: <strong id="selected-tag-display"></strong>
        <button id="clear-filter" class="ml-2 text-blue-600 hover:underline cursor-pointer">Clear filter</button>
      </p>
    </div>
    
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-3">Topics</h2>
      <div class="flex flex-wrap gap-2">
        <button 
          id="tag-all"
          class="px-3 py-1 rounded-full text-sm transition-colors bg-blue-600 text-white"
        >
          All
        </button>
        {allTags.map(tag => (
          <button 
            class="tag-filter px-3 py-1 rounded-full text-sm transition-colors bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700"
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
    
    <div class="space-y-6" id="posts-container">
      {posts.map((post) => (
        <div class="post-item border dark:border-slate-700 rounded-lg p-6 hover:shadow-md transition-shadow" data-tags={JSON.stringify(post.data.tags || [])}>
          <h2 class="text-xl font-bold mb-2">
            <a href={`/writing/${post.slug}`} class="hover:text-blue-600 dark:hover:text-blue-400">{post.data.title}</a>
          </h2>
          <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-3">
            <time>
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span>&middot;</span>
            <span>{getReadingTime(post.body)} min read</span>
            {post.data.draft && <span class="ml-1 px-2 py-0.5 bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-200 text-xs rounded-full">Draft</span>}
          </div>
          
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-3">
              {post.data.tags.map(tag => (
                <span class="text-xs bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )}
          
          <a href={`/writing/${post.slug}`} class="text-sm text-blue-600 hover:underline">Read more →</a>
        </div>
      ))}
      
      <div id="no-posts-message" class="text-center py-12 border dark:border-slate-700 rounded-lg hidden">
        <p class="text-xl text-slate-500 dark:text-slate-400">No posts found for this topic.</p>
      </div>
    </div>
  </div>

  <script is:inline src="/js/tag-filter.js"></script>
</BaseLayout>
